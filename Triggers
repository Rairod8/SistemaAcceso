CREATE TRIGGER trg_InsertUsuario
ON Usuarios
AFTER INSERT
AS
BEGIN

    INSERT INTO LogsUsuarios (
        UsuarioAfectado,
        Accion,
        Descripcion
    )
    SELECT
        DNI,
        'INSERT',
        CONCAT('Se creó el usuario ', Nombre)
    FROM inserted;

END;
GO


CREATE TRIGGER trg_UpdateUsuario
ON Usuarios
AFTER UPDATE
AS
BEGIN

    INSERT INTO LogsUsuarios (
        UsuarioAfectado,
        Accion,
        Descripcion
    )
    SELECT
        i.DNI,
        'UPDATE',
        CONCAT(
            'Usuario actualizado de ',
            d.Nombre,
            ' a ',
            i.Nombre
        )
    FROM inserted i
    INNER JOIN deleted d
        ON i.DNI = d.DNI;

END;
GO


